# LoveBud 환경변수 예시 파일
# 복사해서 .env 파일로 사용하세요 (gitignore에 추가됨)

# ─────────────────────────────────────────────────────────────────────────────
# Neon PostgreSQL (필수)
# ─────────────────────────────────────────────────────────────────────────────
# Netlify에서 사용하는 변수명 (권장)
NETLIFY_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-XXXX.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 또는 일반적인 DATABASE_URL도 지원
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-XXXX.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# Firebase (Netlify Functions용, 로컬 개발 시 선택)
# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─────────────────────────────────────────────────────────────────────────────
# 시드 스크립트 옵션
# ─────────────────────────────────────────────────────────────────────────────
# DRY_RUN=true  # 실제 삽입 없이 미리보기만
# SEED_STAGE=phase1  # phase1 | phase2 | all
