# LoveBud 환경변수 예시 파일
# 복사해서 .env 파일로 사용하세요 (gitignore에 추가됨)
#
# ─────────────────────────────────────────────────────────────────────────────
# 현재 Active deployment / runtime
# ─────────────────────────────────────────────────────────────────────────────
#   - Cloudflare Pages + Pages Functions (functions/**, same-origin /api/*)
#   - Direct-Neon (Neon PostgreSQL 직접 연결, read/write credential 분리)
#   - Firebase ID-token verification (JWKS 기반, service account JSON 불필요)
#   - Modal retained specialized/fallback boundary (MODAL_BASE_URL)
#
# Netlify (*.netlify.app)는 stale/legacy이며 active runtime이 아니다 (#3348).
# netlify/** 트리는 이력 보존용으로만 남아 있다.
#
# 게이트 인벤토리 authority: wrangler.toml [env.production.vars]
# 상세 문서: docs/ops/ENV_DEPENDENCY.md
# 배포 체크리스트: docs/ops/DEPLOY_CHECKLIST.md

# ─────────────────────────────────────────────────────────────────────────────
# 1. DB authority (Direct-Neon)
# ─────────────────────────────────────────────────────────────────────────────
# READ authority — 조회 전용 role. read gate들이 사용한다.
# 누락 시: read gate가 선택된 경로는 503 (fail closed, Modal로 폴백하지 않음)
LOVE_PLATFORM_DATABASE_URL=postgresql://READ_USER:READ_PASSWORD@HOST/DB?sslmode=require

# WRITE authority — 전용 writer role. *_WRITE_RUNTIME gate들이 사용한다.
# 누락 시: write gate가 선택된 경로는 503 (fail closed)
# 중요: read DB authority와 write DB authority는 서로 다른 credential이어야 한다.
#   read DB authority  !=  dedicated write DB authority
LOVE_PLATFORM_WRITE_DATABASE_URL=postgresql://WRITE_USER:WRITE_PASSWORD@HOST/DB?sslmode=require

# 금지된 대체 env (generic/legacy). 전용 authority를 대신할 수 없다.
#   - DATABASE_URL                 : generic (Netlify-era)
#   - NETLIFY_DATABASE_URL         : Netlify-era
#   - DIRECT_NEON_BROWSE_DATABASE_URL : browse 전용
# writer gate가 선택되었는데 위 값만 존재하면 fail closed 하며,
# read authority를 writer credential로 사용하는 것도 금지된다.

# ─────────────────────────────────────────────────────────────────────────────
# 2. Firebase ID-token verification
# ─────────────────────────────────────────────────────────────────────────────
# 선택 항목. 미설정 시 검증기는 기본 project id를 사용한다.
#   authority: functions/_shared/firebase-id-token-verifier.js
#   기본값: relovetree (readFirebaseProjectId)
FIREBASE_PROJECT_ID=relovetree

# 제거된 stale server-auth 안내 (더 이상 사용하지 않음):
#   FIREBASE_SERVICE_ACCOUNT_JSON
#   FIREBASE_SERVICE_ACCOUNT
# 현재 검증은 공개 JWKS 엔드포인트 + Web Crypto 기반이며 service account JSON을 쓰지 않는다.

# ─────────────────────────────────────────────────────────────────────────────
# 3. Modal retained boundary
# ─────────────────────────────────────────────────────────────────────────────
# Modal 전용/폴백 경로의 base URL. Direct-Neon으로 이관되지 않은 경로만 사용한다.
# 누락 시: Modal 경로는 "MODAL_BASE_URL is not configured"로 fail closed
MODAL_BASE_URL=https://YOUR-MODAL-WORKSPACE.modal.run

# ─────────────────────────────────────────────────────────────────────────────
# 4. Production Direct-Neon gate inventory
#    (wrangler.toml [env.production.vars] 와 정확히 동일한 집합이어야 한다)
# ─────────────────────────────────────────────────────────────────────────────
LB_GROWING_READ_RUNTIME=direct_neon
LB_COMMUNITY_MEMORIES_READ_RUNTIME=direct_neon
LB_BROWSE_SUMMARY_READ_RUNTIME=direct_neon
LB_TREE_COMMENT_WRITE_RUNTIME=direct_neon
LB_TREE_COMMENT_READ_RUNTIME=direct_neon
LB_TREE_LIKE_WRITE_RUNTIME=direct_neon
LB_TREE_FORK_WRITE_RUNTIME=direct_neon
LB_MEMORY_UPDATE_WRITE_RUNTIME=direct_neon
LB_OWNER_MEMORY_DETAIL_RUNTIME=direct_neon
LB_OWNER_MEMORIES_READ_RUNTIME=direct_neon
LB_OWNER_TREE_DETAIL_RUNTIME=direct_neon
LB_OWNER_TREES_READ_RUNTIME=direct_neon
LB_PUBLIC_TREE_DETAIL_RUNTIME=direct_neon
LB_MEMORY_DELETE_WRITE_RUNTIME=direct_neon
LB_TREE_DELETE_WRITE_RUNTIME=direct_neon
LB_MEMORY_REACTION_WRITE_RUNTIME=direct_neon
LB_MEMORY_COMMENT_WRITE_RUNTIME=direct_neon
LB_TREE_VIEW_WRITE_RUNTIME=direct_neon
LB_APPRECIATION_ORDER_WRITE_RUNTIME=direct_neon
LB_PUBLIC_MEMORY_DETAIL_RUNTIME=direct_neon
LB_HUB_LAYOUT_WRITE_RUNTIME=direct_neon
LB_HUB_LAYOUT_READ_RUNTIME=direct_neon
LB_TREE_UPDATE_WRITE_RUNTIME=direct_neon
LB_TREE_CREATE_WRITE_RUNTIME=direct_neon
LB_TREE_PRIVATE_CREATE_WRITE_RUNTIME=direct_neon
LB_MEMORY_CREATE_WRITE_RUNTIME=direct_neon
LB_PRIVATE_TREE_CAPABILITY_READ_RUNTIME=direct_neon
LB_MEMORY_AUTH_REACTION_READ_RUNTIME=direct_neon
LB_MEMORY_PUBLIC_REACTION_READ_RUNTIME=direct_neon
LB_MEMORY_AUTH_COMMENT_READ_RUNTIME=direct_neon
LB_MEMORY_PUBLIC_COMMENT_READ_RUNTIME=direct_neon

# 참고: gate 이름의 suffix(_READ_RUNTIME / _WRITE_RUNTIME / _DETAIL_RUNTIME)만으로
# DB credential을 판단하지 않는다. 각 gate의 실제 담당 adapter가 어떤 DB env를
# 쓰는지는 functions/_shared/*-direct-neon.js 가 authority다.

# ─────────────────────────────────────────────────────────────────────────────
# 5. 시드 스크립트 옵션
# ─────────────────────────────────────────────────────────────────────────────
# DRY_RUN=true  # 실제 삽입 없이 미리보기만
# SEED_STAGE=phase1  # phase1 | phase2 | all

# ─────────────────────────────────────────────────────────────────────────────
# 6. 검증 스크립트
# ─────────────────────────────────────────────────────────────────────────────
# node scripts/verify-env.cjs                          # 로컬 환경변수 + gate/adapter drift 검증
# node scripts/verify-env.cjs --remote                 # 원격 엔드포인트 확인 (기본 https://lovebud.pages.dev)
# node scripts/verify-env.cjs --remote https://lovebud.pages.dev
# node scripts/verify-env.cjs --connect                # (선택) DB 연결 확인
