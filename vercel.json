{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/intro.html", "destination": "/pages/intro.html" },
    { "source": "/login.html", "destination": "/pages/login.html" },
    { "source": "/search.html", "destination": "/pages/search.html" },
    { "source": "/detail.html", "destination": "/pages/detail.html" },
    { "source": "/editor.html", "destination": "/pages/editor.html" },
    { "source": "/my-trees.html", "destination": "/pages/my-trees.html" },
    { "source": "/api/:path*", "destination": "https://lovebud.netlify.app/api/:path*" }
  ]
}
