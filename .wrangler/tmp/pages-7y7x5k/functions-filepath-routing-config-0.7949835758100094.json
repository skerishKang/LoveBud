{
  "routes": [
    {
      "routePath": "/api/memories/:id",
      "mountPath": "/api/memories",
      "method": "DELETE",
      "module": [
        "api/memories/[id].js:onRequestDelete"
      ]
    },
    {
      "routePath": "/api/memories/:id",
      "mountPath": "/api/memories",
      "method": "GET",
      "module": [
        "api/memories/[id].js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/memories/:id",
      "mountPath": "/api/memories",
      "method": "PUT",
      "module": [
        "api/memories/[id].js:onRequestPut"
      ]
    },
    {
      "routePath": "/api/trees/:id",
      "mountPath": "/api/trees",
      "method": "DELETE",
      "module": [
        "api/trees/[id].js:onRequestDelete"
      ]
    },
    {
      "routePath": "/api/trees/:id",
      "mountPath": "/api/trees",
      "method": "GET",
      "module": [
        "api/trees/[id].js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/trees/:id",
      "mountPath": "/api/trees",
      "method": "PUT",
      "module": [
        "api/trees/[id].js:onRequestPut"
      ]
    },
    {
      "routePath": "/api/memories",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/memories.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/memories",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/memories.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/trees",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/trees.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/trees",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/trees.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/:path*",
      "mountPath": "/api",
      "method": "",
      "module": [
        "api/[[path]].js:onRequest"
      ]
    }
  ],
  "baseURL": "/"
}