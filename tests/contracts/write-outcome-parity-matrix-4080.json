      "name": "commit not_reached with reread visible",
      "facts": { "transport": "ok", "commit": "not_reached", "returning": "unknown", "reread": "visible" },
      "expected_error": "CONTRADICTORY_FACTS"
    },
    {
      "id": "C07",
      "name": "rolled_back with reread visible",
