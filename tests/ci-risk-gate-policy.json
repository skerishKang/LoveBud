{
  "schema_version": "1.0.0",
  "title": "LoveBud CI Risk-Tier Gate Policy",
  "description": "Machine-readable risk-tier gate policy for LoveBud CI. Maps Tier/UI/capability combinations to required and conditional execution groups, manual evidence obligations, and merge blockers.",
  "tier_enum": ["TIER_1", "TIER_2", "TIER_3"],
  "ui_class_enum": ["NOT_APPLICABLE", "U0", "U1", "U2", "U3"],
  "capability_enum": [
    "copy_or_docs",
    "visual_only",
    "structural_dom",
    "responsive_layout",
    "accessibility_or_focus",
    "browser_runtime",
    "process_runtime",
    "auth_or_session",
    "api_read",
    "api_write",
    "cache_or_storage_persistence",
    "database",
    "migration",
    "privacy_or_security",
    "provider_or_network",
    "deployment_or_runtime_infra",
    "destructive"
  ],
  "tier_1_not_applicable_allowed_capabilities": [
    "none",
    "copy_or_docs"
  ],
  "sensitive_capabilities": [
    "auth_or_session",
    "api_write",
    "cache_or_storage_persistence",
    "database",
    "migration",
    "privacy_or_security",
    "provider_or_network",
    "deployment_or_runtime_infra",
    "destructive"
  ],
  "execution_group_enum": [
    "SOURCE_STATIC",
    "EXECUTED_FAKE",
    "BROWSER_REAL_LOCAL",
    "PROCESS_REAL_LOCAL",
    "DB_ENGINE",
    "PYTHON_SUPPLEMENTAL",
    "REMOTE_OR_PROVIDER_MANUAL",
    "FULL_DEFAULT_REGRESSION"
  ],
  "tier_ui_matrix": {
    "description": "Allowed Tier/UI combinations. Any combination not listed is INVALID.",
    "allowed_combinations": [
      ["TIER_1", "NOT_APPLICABLE"],
      ["TIER_1", "U0"],
      ["TIER_1", "U1"],
      ["TIER_2", "NOT_APPLICABLE"],
      ["TIER_2", "U1"],
      ["TIER_2", "U2"],
      ["TIER_2", "U3"],
      ["TIER_3", "NOT_APPLICABLE"],
      ["TIER_3", "U2"],
      ["TIER_3", "U3"]
    ]
  },
  "escalation_rules": {
    "description": "Capabilities that force escalation to a higher tier or rejection.",
    "tier_1_not_applicable_blocked": {
      "note": "TIER_1 + NOT_APPLICABLE may only include capabilities from tier_1_not_applicable_allowed_capabilities. Mid-risk capabilities like structural_dom, responsive_layout, accessibility_or_focus, browser_runtime, process_runtime, api_read are blocked at TIER_1.",
      "blocked": [
        "structural_dom",
        "responsive_layout",
        "accessibility_or_focus",
        "browser_runtime",
        "process_runtime",
        "api_read",
        "auth_or_session",
        "api_write",
        "cache_or_storage_persistence",
        "database",
        "migration",
        "privacy_or_security",
        "provider_or_network",
        "deployment_or_runtime_infra",
        "destructive"
      ]
    },
    "u0_u1_blocking_capabilities": {
      "note": "U0 and U1 must NOT include any capability beyond copy_or_docs or visual_only.",
      "blocked": [
        "structural_dom",
        "responsive_layout",
        "accessibility_or_focus",
        "browser_runtime",
        "process_runtime",
        "auth_or_session",
        "api_read",
        "api_write",
        "cache_or_storage_persistence",
        "database",
        "migration",
        "privacy_or_security",
        "provider_or_network",
        "deployment_or_runtime_infra",
        "destructive"
      ]
    },
    "tier_2_u2_sensitive_escalation": {
      "note": "U2 with any sensitive capability must escalate to TIER_3.",
      "sensitive_capabilities": [
        "auth_or_session",
        "api_write",
        "cache_or_storage_persistence",
        "database",
        "migration",
        "privacy_or_security",
        "provider_or_network",
        "deployment_or_runtime_infra",
        "destructive"
      ]
    },
    "u3_sensitive_requires_tier_3": {
      "note": "U3 with any sensitive capability is only valid under TIER_3.",
      "sensitive_capabilities": [
        "auth_or_session",
        "api_write",
        "cache_or_storage_persistence",
        "database",
        "migration",
        "privacy_or_security",
        "provider_or_network",
        "deployment_or_runtime_infra",
        "destructive"
      ]
    }
  },
  "execution_group_policy": {
    "required_groups": {
      "TIER_1": ["SOURCE_STATIC"],
      "TIER_2": ["SOURCE_STATIC", "EXECUTED_FAKE"],
      "TIER_3": ["FULL_DEFAULT_REGRESSION"]
    },
    "conditional_groups": {
      "description": "Groups conditionally required based on specific capabilities.",
      "rules": [
        {
          "capability": "browser_runtime",
          "conditional_groups": ["BROWSER_REAL_LOCAL"],
          "affected_tiers": ["TIER_2", "TIER_3"]
        },
        {
          "capability": "responsive_layout",
          "conditional_groups": ["BROWSER_REAL_LOCAL"],
          "affected_tiers": ["TIER_2", "TIER_3"]
        },
        {
          "capability": "accessibility_or_focus",
          "conditional_groups": ["BROWSER_REAL_LOCAL"],
          "affected_tiers": ["TIER_2", "TIER_3"]
        },
        {
          "capability": "database",
          "conditional_groups": ["DB_ENGINE"],
          "affected_tiers": ["TIER_3"]
        },
        {
          "capability": "migration",
          "conditional_groups": ["DB_ENGINE"],
          "affected_tiers": ["TIER_3"]
        },
        {
          "capability": "process_runtime",
          "conditional_groups": ["PROCESS_REAL_LOCAL"],
          "affected_tiers": ["TIER_2", "TIER_3"]
        },
        {
          "capability": "auth_or_session",
          "conditional_groups": ["PROCESS_REAL_LOCAL"],
          "affected_tiers": ["TIER_3"]
        },
        {
          "capability": "api_read",
          "conditional_groups": ["EXECUTED_FAKE"],
          "affected_tiers": ["TIER_2", "TIER_3"]
        }
      ]
    },
    "manual_evidence_groups": {
      "description": "Groups that represent manual evidence obligations and must never be executed automatically.",
      "groups": ["REMOTE_OR_PROVIDER_MANUAL"],
      "triggers": {
        "capabilities": ["provider_or_network", "deployment_or_runtime_infra"]
      }
    }
  },
  "merge_blockers": {
    "description": "Conditions that block merge regardless of CI status. CI_UNAVAILABLE_INFRA is distinct from CI_EXECUTED_FAILURE and CI_PENDING_EXECUTION. It requires canonical alternative evidence; merge is not ready until alternative evidence is resolved.",
    "hard_blockers": [
      "CI_EXECUTED_FAILURE",
      "CI_PENDING_EXECUTION",
      "UNRESOLVED_DESTRUCTIVE_APPROVAL"
    ],
    "infrastructure_unavailable_posture": {
      "description": "CI_UNAVAILABLE_INFRA: infrastructure is unavailable but no test failure occurred. Not equal to CI_GREEN or CI_EXECUTED_FAILURE. Requires canonical alternative evidence before merge-ready.",
      "status": "CI_UNAVAILABLE_INFRA",
      "alternative_evidence_required": true,
      "merge_ready_without_alternative": false
    },
    "tier_3_requirements": {
      "note": "TIER_3 requires additional verification beyond standard CI.",
      "exact_head_local_validation": true,
      "production_verification_for": ["runtime", "auth", "data", "deployment"]
    }
  },
  "accessibility_focus_evidence_policy": {
    "description": "accessibility_or_focus capability evidence requirements. Distinguishes between static aria copy changes and runtime focus/behavior changes.",
    "static_only_indicator": "aria-label, aria-hidden, non-behavioral accessible name",
    "requires_browser_evidence": ["focus_order", "keyboard_interaction", "runtime_focus_restoration"],
    "under_tier_2_or_3": "BROWSER_REAL_LOCAL evidence required for runtime accessibility changes",
    "non_behavioral_aria_copy_exception": "Simple aria-label/text changes without focus/behavior impact may use SOURCE_STATIC only under TIER_1 U0"
  },
  "policy_version": "1.0.0",
  "policy_date": "2026-07-30",
  "refs": "#3710 #3670"
}
